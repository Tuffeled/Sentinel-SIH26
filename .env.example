# ---------------------------------------------------------------------------
# SIH26188 — Environment configuration (copy to ".env" and edit as needed)
# All settings have sensible defaults; the system runs with an empty .env.
# ---------------------------------------------------------------------------

# --- General ---
APP_NAME=SENTINEL Document Screening
DEMO_MODE=true
OFFICER_NAME=Officer
LOG_LEVEL=INFO

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Database (relative paths are resolved against the project root) ---
DATABASE_URL=sqlite:///data/screening.db

# --- OCR ---
# Path to the Tesseract executable. On Windows the default install location is:
#   C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave blank to rely on the system PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Preferred OCR engine: "auto" (paddle if installed else tesseract), "tesseract", "paddle"
OCR_ENGINE=auto

# --- Face verification ---
# Face engine uses OpenCV YuNet (detector) + SFace (embedder) ONNX models.
# "auto" uses them when the model files exist in backend/app/models_store; "off" disables face.
FACE_ENGINE=auto
# SFace cosine threshold: >= this => same person.
FACE_MATCH_THRESHOLD=0.363

# --- Uploads ---
MAX_UPLOAD_MB=15
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf

# --- Risk engine weights (points added per evidence type) ---
RISK_WEIGHT_MRZ_CHECKSUM_FAILURE=25
RISK_WEIGHT_FIELD_MISMATCH=20
RISK_WEIGHT_FORENSIC_ANOMALY=20
RISK_WEIGHT_FACE_LOW_SIMILARITY=20
RISK_WEIGHT_WATCHLIST_MATCH=30
RISK_WEIGHT_CROSS_DOCUMENT_CONFLICT=15
RISK_WEIGHT_OCR_LOW_CONFIDENCE=5
RISK_WEIGHT_METADATA_ANOMALY=5
RISK_WEIGHT_CLASSIFICATION_UNCERTAIN=5
